# Blasa frontend — production / deployed build.
#
# Only EXPO_PUBLIC_* variables reach the bundle, and they are inlined at build
# time: rebuild after changing any of them.

# Must include the /api/v1 prefix. No trailing slash (the client strips one).
EXPO_PUBLIC_API_URL=https://blasa-api.onrender.com/api/v1

# Must be 0 in production, or the app serves mock data instead of the real API.
EXPO_PUBLIC_MOCK=0

# Optional Sentry. Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_RELEASE=
