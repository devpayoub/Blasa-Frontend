# Blasa frontend environment.
#
# The API client rewrites localhost to 10.0.2.2 on Android emulators, so a plain
# localhost URL works for both the iOS simulator and the web build.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# 1 = serve every request from the in-memory mock router (src/api/mock.ts).
# Set to 0 to talk to the real Django API.
EXPO_PUBLIC_MOCK=1

# Optional Sentry (free tier). The app posts straight to the Store endpoint, so
# no native SDK is needed. Leave empty to disable error reporting.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_RELEASE=
